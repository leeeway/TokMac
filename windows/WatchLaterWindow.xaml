<Window x:Class="TokMac.WatchLaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TokMac"
        Title="稍后看" Height="440" Width="540" MinHeight="260" MinWidth="400"
        Background="{StaticResource BarDark}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <local:WatchLaterThumbnailConverter x:Key="ThumbnailConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Label Content="搜索标题、作者或视频 ID" Target="{Binding ElementName=search}"
                   Foreground="{StaticResource TextWhite}" Padding="0,4,10,4" />
            <TextBox x:Name="search" Padding="5,3" AutomationProperties.Name="搜索标题、作者或视频 ID" />
        </DockPanel>
        <ListBox x:Name="videos" Grid.Row="1" SelectionChanged="OnSelectionChanged"
                 AutomationProperties.Name="已收藏的视频" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="6" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Height="50" Background="#252525" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="▶" Foreground="#C1C1C1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Thumbnail, Converter={StaticResource ThumbnailConverter}}" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.75" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="status" Grid.Row="2" Foreground="{StaticResource TextWhite}" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="removeButton" Content="移除" Padding="12,4" Margin="0,0,8,0" Click="Remove_Click" IsEnabled="False" />
            <Button Content="关闭" Padding="12,4" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="openButton" Content="打开视频" Padding="12,4" Click="Open_Click" IsDefault="True" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
