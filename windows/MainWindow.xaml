<Window x:Class="TokMac.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="TokMac" Height="760" Width="1080"
        MinHeight="560" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        Icon="Resources/app.png">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="taskbarInfo" />
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="toolbarRow" Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation / Action Bar -->
        <Border x:Name="toolbarBar" Grid.Row="0" Background="#1B1B1E" BorderBrush="#2A2A2E" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Resources/app.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="TokMac" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Action Buttons on the Right -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pin on top -->
                    <Button x:Name="btnPin" Content="📌 置顶" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0" Click="BtnPin_Click" ToolTip="窗口置顶 (Ctrl+T)" />

                    <!-- Layout Switch -->
                    <Button x:Name="btnLayout" Content="📱 竖屏小窗" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0" Click="BtnLayout_Click" ToolTip="切换竖屏/桌面模式 (Ctrl+1 / Ctrl+2)" />

                    <!-- Download Video -->
                    <Button x:Name="btnDownload" Content="⬇️ 下载视频" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0" Click="BtnDownload_Click" ToolTip="下载当前播放的视频 (Ctrl+S)" />

                    <!-- Reload -->
                    <Button x:Name="btnReload" Content="🔄 刷新" Style="{StaticResource ToolbarButtonStyle}" Click="BtnReload_Click" ToolTip="刷新页面 (F5 / Ctrl+R)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main WebView2 Container -->
        <Grid Grid.Row="1">
            <wv2:WebView2CompositionControl x:Name="webView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Floating Download Progress HUD Overlay -->
            <Border x:Name="downloadHUD"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,16,0,0" Width="400" Height="70"
                    Background="#E6202024" CornerRadius="12"
                    BorderBrush="#38FFFFFF" BorderThickness="1"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5" />
                </Border.Effect>

                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <TextBlock x:Name="hudIcon" Grid.Column="0" Text="⬇️" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" />

                    <!-- Text details & progress -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                        <TextBlock x:Name="hudTitle" Text="正在下载视频..." FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" />
                        <TextBlock x:Name="hudSubtitle" Text="video.mp4" FontSize="10" Foreground="#A0A0A0" Margin="0,2,0,4" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="hudProgressBar" Height="4" Minimum="0" Maximum="100" Value="0" Background="#333333" Foreground="#0078D4" BorderThickness="0" />
                    </StackPanel>

                    <!-- Action Button / Close Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="hudRevealBtn" Content="在文件夹中显示" Style="{StaticResource AccentButtonStyle}"
                                FontSize="11" Padding="8,4" Margin="0,0,6,0" Visibility="Collapsed" Click="HudRevealBtn_Click" />
                        <Button x:Name="hudCloseBtn" Content="✕" Style="{StaticResource ToolbarButtonStyle}"
                                Width="22" Height="22" Padding="0" Click="HudCloseBtn_Click" ToolTip="关闭" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
